# Resend API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx

# Email that receives contact form submissions
CONTACT_TO_EMAIL=contact@logicminers.au

# Use a sender address from your verified Resend domain
CONTACT_FROM_EMAIL="Logic Miners <noreply@your-verified-domain.com>"

# Optional fallback supported by the API route
# RESEND_FROM_EMAIL="Logic Miners <noreply@your-verified-domain.com>"
